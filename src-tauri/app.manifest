<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded into every MSVC-linked binary (bin + test): without the
     Common-Controls v6 dependency the loader binds comctl32 5.82, which lacks
     SetWindowSubclass/TaskDialogIndirect that tao imports (STATUS_ENTRYPOINT_NOT_FOUND). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="0.1.0.0" processorArchitecture="*" name="com.cracktivity.app" type="win32"/>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0" processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
